# Claude. Required unless you're signed in to Claude Code or using Bedrock/Vertex.
ANTHROPIC_API_KEY=

# Optional providers. Leo falls back gracefully when any of these are missing.
DATAFORSEO_LOGIN=          # live Google SERP (fallback: Firecrawl search)
DATAFORSEO_PASSWORD=
FIRECRAWL_API_KEY=         # competitor scraping + search (fallback: built-in fetch)
PERPLEXITY_API_KEY=        # fresh web research (fallback: Claude web search)
OPENROUTER_API_KEY=        # image generation (fallback: skip images)
SANITY_API_TOKEN=          # publishing to Sanity (fallback: local markdown)
