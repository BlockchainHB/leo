{
  "name": "leo-agent",
  "version": "1.0.0",
  "description": "Research-first SEO writing agent for your terminal. SERP analysis, competitor gaps, a sourced draft, images, and CMS publishing in one command.",
  "type": "module",
  "bin": {
    "leo": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "claude",
    "agent-sdk",
    "ai-agent",
    "seo",
    "blog",
    "content",
    "cli",
    "ink",
    "sanity"
  ],
  "author": "Hasaam Bhatti (https://hasaamb.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BlockchainHB/leo.git"
  },
  "homepage": "https://leoagent.dev",
  "bugs": {
    "url": "https://github.com/BlockchainHB/leo/issues"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.284",
    "@clack/prompts": "^1.8.1",
    "@inkjs/ui": "^2.0.0",
    "@sanity/client": "^8.8.0",
    "commander": "^15.0.0",
    "figlet": "^1.12.0",
    "ink": "^7.1.1",
    "ink-gradient": "^4.0.1",
    "marked": "^18.0.14",
    "react": "^19.3.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
